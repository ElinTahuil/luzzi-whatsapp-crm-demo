# ============================================================
# CRM de WhatsApp — plantilla de variables (valores de ejemplo)
#  Copiá este archivo como ".env" y completá tus valores.
#  NUNCA subas el archivo .env real a Git ni lo compartas.
# ============================================================

# ---- Aplicación ----
NODE_ENV=production
PORT=3000
APP_URL=https://app.tudominio.com
# Origen permitido para CORS / Socket.io en producción (tu dominio del panel)
ALLOWED_ORIGIN=https://app.tudominio.com
# OPCIONAL — Subdominio por cliente (R66.6). Si completás esto con tu dominio
# raíz (ej. "tuapp.com"), cada negocio queda accesible en
# "<slug-del-negocio>.tuapp.com" y esa pantalla precarga ese negocio solo,
# sin selector. Vacío por defecto = función apagada, nada cambia.
# Requiere, ANTES de completar esta variable:
#   1. Un registro DNS wildcard: *.tuapp.com -> la IP de este servidor.
#   2. Un certificado TLS wildcard para *.tuapp.com (gratis con Let's Encrypt
#      + validación DNS, ej. certbot con el plugin de tu proveedor de DNS).
#   3. Que ALLOWED_ORIGIN cubra el dominio raíz si vas a llamar la API desde
#      subdominios distintos al de este ALLOWED_ORIGIN.
# Los slugs "app" y "www" quedan reservados para el panel general del dueño
# (con selector, como hoy) y nunca se resuelven como negocio de un cliente.
APP_BASE_DOMAIN=
# La base se crea/verifica sola al arrancar (idempotente). Para desactivarlo
# (ej. en un VPS donde corrés "npm run setup" a mano), poné: false
RUN_DB_SETUP_ON_BOOT=true

# R66.5: con NODE_ENV=production, el servidor ahora CORTA el arranque (no
# solo avisa) si falta SESSION_SECRET propio, META_APP_SECRET, o la base
# MySQL. Es a propósito: antes esos huecos quedaban como un warning en
# consola que en un VPS nadie revisa, y el webhook de WhatsApp terminaba
# aceptando mensajes sin validar su firma. Si necesitás arrancar igual en un
# ambiente de prueba que todavía no tiene todo configurado, poné esto en
# true a propósito (NO usar en un servidor con clientes reales):
ALLOW_INSECURE_START=false

# ---- Sesión ----
# Generá una cadena larga y aleatoria. Ej: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# ---- Admin inicial (se crea al correr "npm run setup") ----
# Este es el usuario DUEÑO: ve TODOS los negocios.
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-clave
ADMIN_NAME=Administrador
ADMIN_EMAIL=contacto@tudominio.com

# ---- Usuario restringido A (opcional; usuario "scopeado") ----
# Solo ve el negocio "Negocio de ejemplo", nunca los demás clientes.
# Se crea al correr "npm run setup" SOLO si LAB_ADMIN_PASS tiene un valor.
# Si lo dejás vacío, el usuario NO se crea (no shippeamos clave por defecto).
LAB_ADMIN_USER=usuario_a
LAB_ADMIN_PASS=
LAB_ADMIN_NAME=Usuario de ejemplo
LAB_ADMIN_EMAIL=

# ---- Usuario restringido B (opcional) ----
# Solo ve el negocio "Organismo público de ejemplo", nunca los demás clientes.
# Se crea al correr "npm run setup" SOLO si MUNI_ADMIN_PASS tiene un valor.
# Recordá: este tenant vive en la base del CRM. Los reclamos estructurados
# van en la base aparte `sistema_reclamos` (base de ejemplo aparte).
MUNI_ADMIN_USER=usuario_b
MUNI_ADMIN_PASS=
MUNI_ADMIN_NAME=Organismo de ejemplo
MUNI_ADMIN_EMAIL=

# ---- Base de datos MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=tu_base_de_datos
MYSQL_USER=tu_usuario
MYSQL_PASSWORD=tu_password

# ---- Performance / 4 reglas operativas del video ----
# Caché corto para endpoints repetitivos como dashboard. false = desactiva caché.
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_MS=15000
DASHBOARD_CACHE_TTL_MS=20000
# Loguea SQL lento en consola para detectar queries que necesitan índices.
SLOW_QUERY_MS=500
# Cantidad de tareas pesadas simultáneas en segundo plano.
ASYNC_JOB_CONCURRENCY=2
# Cantidad máxima de jobs terminados que se conservan en memoria para consultar estado.
JOB_MEMORY_LIMIT=200

# ---- WhatsApp Cloud API (Meta) ----
# Versión del Graph API. Default actual: v23.0 (jun-2026). Cuando Meta publique
# una versión nueva estable, cambiá solo este valor (no hay que tocar código).
WHATSAPP_API_VERSION=v23.0
# ⚠️ DEADLINE: Meta deprecó el Embedded Signup v2/v3 el 15/10/2026 y NO migra
# solo el modo "coex" (coexistencia) — hay que migrarlo a mano ANTES de esa
# fecha o el popup de alta deja de devolver el código de conexión. Pasos:
#   1. App Dashboard de Meta > "Facebook Login for Business" > Configuraciones
#      > crear una configuración nueva, variación "Embedded Signup", con los
#      productos whatsapp_business_messaging y whatsapp_business_management.
#   2. Suscribir en App Dashboard > WhatsApp > Configuración los topics:
#      history, smb_app_state_sync, smb_message_echoes, account_update
#      (además de messages) para que la coexistencia siga sincronizando.
#   3. Copiar el Configuration ID nuevo acá abajo en META_EMBEDDED_CONFIG_ID
#      (reemplaza al viejo).
#   4. Dejar WHATSAPP_EMBEDDED_SESSION_INFO_VERSION vacío (ver más abajo):
#      el flujo v4 ya no manda ese campo.
#   5. Probar el botón "Conectar WhatsApp" con un número de prueba de Meta
#      ANTES de usarlo con un cliente real — es una integración externa que
#      no se puede validar sin credenciales reales de tu app de Meta.
# Token de verificación que vos elegís (lo pegás igual en Meta al configurar el webhook)
WHATSAPP_VERIFY_TOKEN=elegi-un-token-de-verificacion
# App Secret de tu app de Meta (Configuración > Básica). Sirve para validar la firma de los webhooks.
META_APP_SECRET=tu_app_secret_de_meta
# Embedded Signup (alta automática de clientes, modelo Tech Provider):
# App ID de tu app de Meta (Configuración > Básica). NO es secreto.
META_APP_ID=
# Identificador de la configuración de "Facebook Login for Business" (v4).
# Ver los 5 pasos de migración en el comentario de arriba.
META_EMBEDDED_CONFIG_ID=
# OPCIONAL — bandera de emergencia, dejar VACÍO en el caso normal (v4).
# Solo completar con un número (ej. 3) si Meta todavía no terminó de migrar
# "coex" para tu app y necesitás forzar el flujo viejo un tiempo más.
WHATSAPP_EMBEDDED_SESSION_INFO_VERSION=
# Las credenciales por negocio (phone_number_id + access_token) se guardan en la
# tabla "businesses", NO acá. Esto permite varios negocios con números distintos.
# OPCIONAL: si completás estos dos, "npm run setup" pre-carga el primer negocio
# (Admin / número histórico) con estas credenciales. Si no, lo dejás vacío y lo cargás luego.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---- Messenger (Meta) — R66.11 ----
# NO hace falta ninguna variable nueva: Messenger es un producto MÁS de la
# MISMA app de Meta que ya usás para WhatsApp, así que reutiliza
# WHATSAPP_VERIFY_TOKEN (para verificar el webhook) y META_APP_SECRET (para
# validar la firma de los mensajes entrantes) de más arriba.
#
# Pasos en el App Dashboard de Meta para habilitar Messenger:
#   1. Agregar el producto "Messenger" a tu app de Meta (si todavía no está).
#   2. Messenger > Configuración de la app > Generar un "Page Access Token"
#      para la Página de Facebook del cliente (el cliente tiene que darte
#      acceso de administrador/editor a su Página, o agregarte como "Task
#      Access" con permiso de mensajería).
#   3. Messenger > Webhooks > Agregar Callback URL:
#      https://TU-DOMINIO/webhook/messenger  (mismo Verify Token de arriba)
#      y suscribir el topic "messages" (y "messaging_postbacks" si a futuro
#      se agregan botones nativos).
#   4. Pegar el Page ID y el Page Access Token desde el panel del CRM:
#      Negocios → botón "Messenger" en la fila del negocio correspondiente.
#      (Las credenciales quedan guardadas en la tabla business_channels, NO acá:
#      un negocio puede tener varios canales conectados a la vez.)
#   5. Igual que con WhatsApp: probar con una Página de prueba ANTES de usarlo
#      con un cliente real — no se puede validar sin credenciales reales de Meta.

# ---- Instagram Direct (Meta) — R66.12 ----
# Tampoco hace falta ninguna variable nueva: reutiliza WHATSAPP_VERIFY_TOKEN
# y META_APP_SECRET, igual que Messenger (misma app de Meta).
#
# Requisito previo IMPORTANTE: la cuenta de Instagram del cliente tiene que
# ser una cuenta PROFESIONAL (business o creator) — Instagram NO ofrece API
# de mensajería para cuentas personales — y tiene que estar VINCULADA a una
# Página de Facebook (Configuración de la cuenta de IG > Página vinculada).
#
# Pasos en el App Dashboard de Meta para habilitar Instagram:
#   1. Agregar el producto "Instagram" a tu app de Meta (si todavía no está).
#   2. Pedir/verificar los permisos instagram_basic, instagram_manage_messages
#      y pages_show_list (Advanced Access, mismo trámite que ya hicieron para
#      WhatsApp como Tech Provider).
#   3. Obtener el ig_user_id de la cuenta profesional del cliente: se consulta
#      con GET /{page-id}?fields=instagram_business_account usando el Page
#      Access Token de la Página vinculada.
#   4. Instagram > Webhooks > Agregar Callback URL:
#      https://TU-DOMINIO/webhook/instagram  (mismo Verify Token de arriba)
#      y suscribir el topic "messages".
#   5. Pegar el ID de cuenta de Instagram y el Page Access Token desde el
#      panel del CRM: Negocios → botón "Instagram" en la fila del negocio.
#      (Igual que Messenger, queda guardado en business_channels, NO acá.)
#   6. ⚠️ La API de mensajería de Instagram es la que más cambia de las tres
#      — antes de dar de alta un cliente real, revisar la documentación
#      vigente de Meta (developers.facebook.com/docs/messenger-platform/
#      instagram) por si el nodo exacto para mandar mensajes cambió de
#      versión. No se puede validar sin credenciales reales de una cuenta
#      profesional de Instagram.

# ---- TikTok Business Messaging — R66.13 (DEJADO PREPARADO, no probado) ----
# A diferencia de Messenger/Instagram, TikTok NO es un producto de Meta:
# es un ecosistema de desarrollador totalmente aparte, con su propia app y
# sus propias credenciales. Por eso hacen falta variables nuevas acá (no
# reutiliza nada de WHATSAPP_*/META_*).
#
# Sin estas dos variables cargadas, el canal queda COMPLETAMENTE apagado:
# ni siquiera aparece el botón "TikTok" en el panel de Negocios. Con ambas
# cargadas, aparece pero con una advertencia visible de que es un canal sin
# verificar contra documentación real (ver el banner completo en
# services/channels/tiktok.js) — la referencia técnica de la Business
# Messaging API vive detrás de un login de Partner al que no se pudo
# acceder para armar este paquete. ANTES de conectar una cuenta real:
#   1. Registrar una app en el TikTok for Business Developer Portal
#      (business-api.tiktok.com/portal) y pedir acceso a Business Messaging.
#   2. Revisar ahí mismo la referencia técnica real (nodo exacto para
#      mandar mensajes, nombre de los headers de firma del webhook, forma
#      del payload entrante) y ajustar services/channels/tiktok.js si
#      difiere de lo que quedó armado acá.
#   3. Probar con una cuenta de prueba ANTES de usarlo con un cliente real.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# OPCIONAL — normalmente no hace falta tocar esto. Sirve para corregir el
# host/versión del API sin tener que editar código, apenas se confirme
# contra documentación real (ver services/channels/tiktok.js).
TIKTOK_API_BASE_URL=https://business-api.tiktok.com/open_api/v1.3
# OPCIONALES — nombres de los headers de firma/timestamp del webhook, por
# si la documentación real de Partner confirma nombres distintos a los que
# se asumieron acá (ver SIGNATURE_HEADER/TIMESTAMP_HEADER en tiktok.js).
TIKTOK_SIGNATURE_HEADER=
TIKTOK_TIMESTAMP_HEADER=
TIKTOK_SEND_MESSAGE_PATH=

# ---- Inteligencia Artificial (Google Gemini) ----
GEMINI_API_KEY=tu_api_key_de_gemini
# Modelo recomendado para arrancar barato: Gemini 2.5 Flash-Lite.
# Es rápido y económico para respuestas cortas de WhatsApp. Si necesitás
# más razonamiento, podés cambiar a gemini-2.5-flash desde el panel.
GEMINI_MODEL=gemini-2.5-flash-lite

# ---- Respaldo de IA (OPCIONAL): otros proveedores con su propio cupo gratis ----
# El bot intenta los proveedores en este orden. Si uno se queda sin cuota o no
# tiene API key, pasa al siguiente. Dejalos vacíos para usar solo Gemini.
AI_PROVIDER_ORDER=gemini,groq,openrouter
# Ajustes para ahorrar tokens en modelos gratuitos
AI_CONTEXT_MESSAGES=6
AI_MAX_OUTPUT_TOKENS=220
AI_TEMPERATURE=0.45
# Varias keys de Gemini solo sirven como respaldo real si pertenecen a proyectos/cuentas con cuota separada.
GEMINI_API_KEYS=
# Groq: registrate gratis en https://console.groq.com y pegá la API key acá.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter: registrate gratis en https://openrouter.ai/keys y pegá la API key acá.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Retención de datos (opcional) ----
# 0 = no borra nada (por defecto). Si ponés un número > 0, una tarea diaria
# borra los MENSAJES más viejos que esa cantidad de días (no toca contactos,
# turnos ni leads). Sirve para que la base no crezca sin control. Es permanente.
MESSAGE_RETENTION_DAYS=0

# ---- Email (notificaciones de leads) ----
# Para Gmail necesitás una "Contraseña de aplicación" (no tu clave normal).
GMAIL_USER=contacto@tudominio.com
GMAIL_PASS=
NOTIFY_EMAIL=contacto@tudominio.com


# ---- Planes y permisos ----
# Los planes NO se manejan por .env. Se cambian desde el panel del dueño:
# Negocios > Plan / IA / A demanda.
# Básico = reglas + menú + humano. Pro = Básico + IA. Premium = Pro + Mercado/a demanda.

# ---- Módulo Mercado / Agencia cerealera ----
# Recomendado para arrancar: on_demand. Si MARKET_PROVIDER_URL está vacío,
# el sistema usa la última cotización manual/demo cargada en MySQL.
MARKET_PROVIDER_MODE=on_demand
MARKET_PROVIDER_NAME=
# Endpoint REST del proveedor de cotizaciones cuando lo tengas.
# El CRM lo llamará con parámetros: ?commodity=soja&symbol=soja&producto=soja
MARKET_PROVIDER_URL=
MARKET_PROVIDER_API_KEY=
MARKET_PROVIDER_TIMEOUT_MS=8000

# ---- Alerta al dueño cuando un cliente pide hablar con una persona ----
# Número personal en formato internacional, SOLO dígitos (sin + ni espacios).
OWNER_WHATSAPP=5490000000000
# Nombre EXACTO de la plantilla de utilidad que avisa al dueño (creala y aprobala en Meta).
HANDOFF_TEMPLATE=handoff_alert
HANDOFF_TEMPLATE_LANG=es_AR

# Negocio (slug) para el que se manda la alerta por WhatsApp. Para los demás
# negocios igual te llega por push/email, pero no por WhatsApp.
OWNER_ALERT_BUSINESS=admin

# ---- Notificaciones push al celular (Web Push / PWA) ----
# OPCIONAL. Si dejás esto vacío, el sistema genera las claves la primera vez
# y las guarda en la base (tabla app_settings). No tenés que hacer nada.
# Si querés fijarlas vos: generalas con  ->  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Identidad del remitente del push (un mailto o una URL). Por defecto usa ADMIN_EMAIL.
VAPID_SUBJECT=mailto:contacto@tudominio.com

# ============================================================
# Storage / Centro de datos del negocio (v2.33)
# ============================================================
# local = guarda archivos controlados en el hosting mientras estás empezando.
# gcs/s3/r2 quedan preparados para migración futura con StorageService.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=data/storage
STORAGE_TEMP_DIR=data/tmp
STORAGE_MAX_FILE_MB=15
STORAGE_TEMP_RETENTION_DAYS=7
STORAGE_DEFAULT_QUOTA_MB=500
STOCK_IMPORT_FILE_RETENTION_DAYS=15
# Futuro Google Cloud Storage
GCS_BUCKET=
GCS_PROJECT_ID=

# ============================================================
# Integraciones Google por negocio (v2.33)
# ============================================================
# Se usan para que CADA comercio conecte su propia cuenta Google.
# No reemplazan el StorageService: son fuentes externas para Sheets/Drive/Calendar.
# Crear credenciales OAuth Web en Google Cloud / Google APIs y configurar como
# redirect autorizado: https://TU_DOMINIO/api/google/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.tudominio.com/api/google/oauth/callback
GOOGLE_SHEETS_DEFAULT_RANGE=A:Z
